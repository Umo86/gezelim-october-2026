# ── Required ────────────────────────────────────────────────────────────────
# Postgres connection string. On Vercel with the Neon integration this is set for you.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/gezelim
# Any long random string (e.g. `openssl rand -hex 32`). Signs admin sessions.
PAYLOAD_SECRET=
# The public address, used for canonical links, sitemaps and share cards.
# Search engines are only let in when this is set (production only), so set it at launch.
NEXT_PUBLIC_SITE_URL=https://gezelim.co

# ── Photos: Cloudflare R2 (leave empty locally to store uploads in ./media) ──
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gezelim-media

# ── Search engines ──────────────────────────────────────────────────────────
# IndexNow (Bing, Yandex, Seznam, Naver): any 32-character hex string, e.g. `openssl rand -hex 16`.
INDEXNOW_KEY=
# Ownership tags from Google Search Console, Bing Webmaster Tools and Yandex Webmaster (content value only).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Used for admin password resets and new-submission alerts.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=hello@gezelim.co
# Where "new event submitted" alerts go.
ADMIN_NOTIFY_EMAIL=

# ── Spam protection on the add-event form (Cloudflare Turnstile) ────────────
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Optional ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=hello@gezelim.co
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_WHATSAPP_CHANNEL_URL=
# Create a first admin when running `npm run seed` on an empty database.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
